<mxfile host="65bd71144e" pages="3">
    <diagram id="setup" name="1 - Installation and Setup">
        <mxGraphModel dx="2016" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" value="Vendor Channel — Installation, Configuration and Go-Live" style="text;html=1;align=center;verticalAlign=middle;fontSize=26;fontStyle=1;fontColor=#1F2937;" parent="1" vertex="1">
                    <mxGeometry x="200" y="20" width="1250" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="subtitle" value="Complete these steps in order. Do not enable live synchronization until every validation gate is green." style="text;html=1;align=center;fontSize=14;fontColor=#4B5563;" parent="1" vertex="1">
                    <mxGeometry x="300" y="70" width="1050" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="lane1" value="Administrator" style="swimlane;html=1;horizontal=0;startSize=34;fillColor=#E3F2FD;strokeColor=#1976D2;fontStyle=1;fontSize=14;" parent="1" vertex="1">
                    <mxGeometry x="40" y="120" width="1540" height="220" as="geometry"/>
                </mxCell>
                <mxCell id="s1" value="1. Deploy integration&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;• Stable public HTTPS URL&lt;/div&gt;&lt;div&gt;• Database available&lt;/div&gt;&lt;div&gt;• Scheduler running every minute&lt;/div&gt;&lt;div&gt;• Queue worker supervised&lt;/div&gt;&lt;div&gt;• APP_DEBUG=false in production&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1976D2;align=left;spacing=12;fontSize=13;" parent="lane1" vertex="1">
                    <mxGeometry x="55" y="35" width="250" height="155" as="geometry"/>
                </mxCell>
                <mxCell id="s2" value="2. Configure Linnworks app&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;• External channel endpoints use HTTPS base URL&lt;/div&gt;&lt;div&gt;• Orders, inventory, listings and post-sale enabled&lt;/div&gt;&lt;div&gt;• Required listing/configurator permissions granted&lt;/div&gt;&lt;div&gt;• ChannelName remains stable&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1976D2;align=left;spacing=12;fontSize=13;" parent="lane1" vertex="1">
                    <mxGeometry x="365" y="35" width="270" height="155" as="geometry"/>
                </mxCell>
                <mxCell id="s3" value="3. Install from Linnworks&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Open the app from Linnworks and approve authorization. The integration creates or updates the tenant and stores the Linnworks account identity.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1976D2;align=left;spacing=12;fontSize=13;" parent="lane1" vertex="1">
                    <mxGeometry x="695" y="35" width="250" height="155" as="geometry"/>
                </mxCell>
                <mxCell id="s4" value="4. Enter Vendor credentials&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;• Account ID&lt;/div&gt;&lt;div&gt;• API key&lt;/div&gt;&lt;div&gt;• Account token&lt;/div&gt;&lt;div&gt;• Environment: stage or prod&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Use separate credentials per environment.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1976D2;align=left;spacing=12;fontSize=13;" parent="lane1" vertex="1">
                    <mxGeometry x="1005" y="35" width="230" height="155" as="geometry"/>
                </mxCell>
                <mxCell id="s5" value="5. Save and test config&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;ConfigTest must succeed. If it fails, verify HTTPS URL, credentials, account environment, database connectivity and endpoint routing before continuing.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F9A825;align=left;spacing=12;fontSize=13;fontStyle=1;" parent="lane1" vertex="1">
                    <mxGeometry x="1295" y="35" width="210" height="155" as="geometry"/>
                </mxCell>
                <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;strokeColor=#1976D2;strokeWidth=2;" parent="lane1" source="s1" vendor="s2" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#1976D2;strokeWidth=2;" parent="lane1" source="s2" vendor="s3" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#1976D2;strokeWidth=2;" parent="lane1" source="s3" vendor="s4" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#1976D2;strokeWidth=2;" parent="lane1" source="s4" vendor="s5" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="lane2" value="Catalog and SKU Preparation" style="swimlane;html=1;horizontal=0;startSize=34;fillColor=#E8F5E9;strokeColor=#388E3C;fontStyle=1;fontSize=14;" parent="1" vertex="1">
                    <mxGeometry x="40" y="370" width="1540" height="235" as="geometry"/>
                </mxCell>
                <mxCell id="c1" value="6. Run initial catalog sync&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;php artisan vendor:sync-catalog&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Vendor products are stored in vendor_products and exposed to Linnworks through /api/Product/Products.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#388E3C;align=left;spacing=12;fontSize=13;" parent="lane2" vertex="1">
                    <mxGeometry x="80" y="45" width="300" height="155" as="geometry"/>
                </mxCell>
                <mxCell id="c2" value="7. Confirm products appear&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;In Linnworks channel mapping, refresh/download channel products. Confirm Vendor SKU, title, price and available quantity are present.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#388E3C;align=left;spacing=12;fontSize=13;" parent="lane2" vertex="1">
                    <mxGeometry x="455" y="45" width="280" height="155" as="geometry"/>
                </mxCell>
                <mxCell id="c3" value="8. Link SKUs&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Map each Vendor channel SKU to the correct Linnworks inventory item. SKU values must be non-empty and unique enough to identify the product.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#388E3C;align=left;spacing=12;fontSize=13;" parent="lane2" vertex="1">
                    <mxGeometry x="810" y="45" width="280" height="155" as="geometry"/>
                </mxCell>
                <mxCell id="c4" value="VALIDATION GATE&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;✓ Catalog populated&lt;/div&gt;&lt;div&gt;✓ Channel products visible&lt;/div&gt;&lt;div&gt;✓ Every sellable SKU mapped&lt;/div&gt;&lt;div&gt;✓ No duplicate/blank SKU&lt;/div&gt;&lt;div&gt;✓ Inventory location selected&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Unmapped SKUs can cause invalid order lines and failed inventory updates.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;align=left;spacing=12;fontSize=13;fontStyle=1;" parent="lane2" vertex="1">
                    <mxGeometry x="1160" y="35" width="310" height="175" as="geometry"/>
                </mxCell>
                <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#388E3C;strokeWidth=2;" parent="lane2" source="c1" vendor="c2" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#388E3C;strokeWidth=2;" parent="lane2" source="c2" vendor="c3" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#388E3C;strokeWidth=2;" parent="lane2" source="c3" vendor="c4" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="lane3" value="Go-Live Validation" style="swimlane;html=1;horizontal=0;startSize=34;fillColor=#F3E5F5;strokeColor=#7B1FA2;fontStyle=1;fontSize=14;" parent="1" vertex="1">
                    <mxGeometry x="40" y="635" width="1540" height="410" as="geometry"/>
                </mxCell>
                <mxCell id="g1" value="9. Set Order Sync Date&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Set it slightly before the oldest test order&#39;s last-updated timestamp. Linnworks requests orders from this cursor; the integration returns locally cached vendor_orders.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7B1FA2;align=left;spacing=12;fontSize=13;" parent="lane3" vertex="1">
                    <mxGeometry x="65" y="45" width="280" height="145" as="geometry"/>
                </mxCell>
                <mxCell id="g2" value="10. Test an order&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Create or expose one Vendor test order. Wait for the 5-minute pull and Linnworks polling cycle. Verify ReferenceNumber, SKU, line number, totals and address.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7B1FA2;align=left;spacing=12;fontSize=13;" parent="lane3" vertex="1">
                    <mxGeometry x="405" y="45" width="280" height="145" as="geometry"/>
                </mxCell>
                <mxCell id="g3" value="11. Test inventory&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Change mapped Linnworks stock. Verify /api/Product/InventoryUpdate is called and the Vendor/mock quantity changes. Repeat once to confirm updates are safe.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7B1FA2;align=left;spacing=12;fontSize=13;" parent="lane3" vertex="1">
                    <mxGeometry x="745" y="45" width="280" height="145" as="geometry"/>
                </mxCell>
                <mxCell id="g4" value="12. Test listing lifecycle&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Create listing → wait for feed status → edit price/content → deactivate → optionally delete. Confirm the same channel listing is updated, not duplicated.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7B1FA2;align=left;spacing=12;fontSize=13;" parent="lane3" vertex="1">
                    <mxGeometry x="1085" y="45" width="280" height="145" as="geometry"/>
                </mxCell>
                <mxCell id="g5" value="13. Test fulfillment&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Process the imported order in Linnworks and add carrier, service and tracking. Verify the Vendor/mock order is marked shipped and duplicate callbacks do not create duplicate shipments.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7B1FA2;align=left;spacing=12;fontSize=13;" parent="lane3" vertex="1">
                    <mxGeometry x="235" y="225" width="310" height="145" as="geometry"/>
                </mxCell>
                <mxCell id="g6" value="14. Test exception paths&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Verify cancellation and refund with test orders. Check correlation IDs and sync_logs. Confirm invalid credentials and validation failures produce actionable errors.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7B1FA2;align=left;spacing=12;fontSize=13;" parent="lane3" vertex="1">
                    <mxGeometry x="620" y="225" width="310" height="145" as="geometry"/>
                </mxCell>
                <mxCell id="g7" value="GO LIVE&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;✓ All seven capabilities pass&lt;/div&gt;&lt;div&gt;✓ Scheduler and workers supervised&lt;/div&gt;&lt;div&gt;✓ Monitoring and backups enabled&lt;/div&gt;&lt;div&gt;✓ Mock routes inaccessible&lt;/div&gt;&lt;div&gt;✓ Production Vendor contract validated&lt;/div&gt;&lt;div&gt;✓ Support owner identified&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=3;align=left;spacing=12;fontSize=14;fontStyle=1;" parent="lane3" vertex="1">
                    <mxGeometry x="1005" y="215" width="330" height="165" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="flows" name="2 - Synchronization Flows">
        <mxGraphModel dx="2016" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
            <root>
                <mxCell id="f0"/>
                <mxCell id="f1" parent="f0"/>
                <mxCell id="ftitle" value="Who Initiates Each Synchronization?" style="text;html=1;align=center;fontSize=26;fontStyle=1;fontColor=#1F2937;" parent="f1" vertex="1">
                    <mxGeometry x="350" y="20" width="950" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="vendor" value="TARGET PLUS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CC0000;fontColor=#FFFFFF;strokeColor=#990000;fontStyle=1;fontSize=20;" parent="f1" vertex="1">
                    <mxGeometry x="80" y="100" width="300" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="adapter" value="LARAVEL CHANNEL ADAPTER&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;MySQL: tenants, vendor_orders, vendor_products, listing feeds, sync logs and idempotency state&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#7B1FA2;strokeWidth=2;fontStyle=1;fontSize=16;" parent="f1" vertex="1">
                    <mxGeometry x="590" y="90" width="470" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="linn" value="LINNWORKS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1976D2;fontColor=#FFFFFF;strokeColor=#0D47A1;fontStyle=1;fontSize=20;" parent="f1" vertex="1">
                    <mxGeometry x="1280" y="100" width="300" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="orders" value="ORDER SYNC&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;1. Scheduler pulls Vendor every 5 min&lt;/div&gt;&lt;div&gt;2. Upsert into vendor_orders&lt;/div&gt;&lt;div&gt;3. Linnworks polls /api/Order/Orders (~10 min observed)&lt;/div&gt;&lt;div&gt;4. Adapter returns orders after Order Sync Date&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Owner action: set sync date and ensure SKU mapping.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F9A825;align=left;spacing=12;fontSize=14;" parent="f1" vertex="1">
                    <mxGeometry x="80" y="250" width="460" height="210" as="geometry"/>
                </mxCell>
                <mxCell id="catalog" value="PRODUCT / CATALOG SYNC&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;1. Scheduler calls Vendor hourly&lt;/div&gt;&lt;div&gt;2. Upsert products into vendor_products&lt;/div&gt;&lt;div&gt;3. Linnworks requests /api/Product/Products&lt;/div&gt;&lt;div&gt;4. User maps channel SKU to Linnworks item&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Owner action: resolve missing or duplicate SKUs.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#388E3C;align=left;spacing=12;fontSize=14;" parent="f1" vertex="1">
                    <mxGeometry x="600" y="250" width="460" height="210" as="geometry"/>
                </mxCell>
                <mxCell id="inventory" value="INVENTORY SYNC&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;1. Stock changes in Linnworks&lt;/div&gt;&lt;div&gt;2. Linnworks calls /api/Product/InventoryUpdate&lt;/div&gt;&lt;div&gt;3. Adapter resolves mapped SKU&lt;/div&gt;&lt;div&gt;4. Adapter PUTs quantity to Vendor&lt;/div&gt;&lt;div&gt;5. 30-min snapshot sync refreshes channel view&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Owner action: maintain mapping and location selection.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1976D2;align=left;spacing=12;fontSize=14;" parent="f1" vertex="1">
                    <mxGeometry x="1120" y="250" width="460" height="210" as="geometry"/>
                </mxCell>
                <mxCell id="listing" value="LISTING CREATION AND CONTROL&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;1. User creates listing with Vendor configurator&lt;/div&gt;&lt;div&gt;2. Linnworks calls ListingUpdate&lt;/div&gt;&lt;div&gt;3. Adapter creates/updates Vendor product&lt;/div&gt;&lt;div&gt;4. Linnworks polls CheckFeed&lt;/div&gt;&lt;div&gt;5. Edit repeats ListingUpdate&lt;/div&gt;&lt;div&gt;6. Deactivate/delete calls ListingDelete&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Owner action: monitor feed result; retry only safe failures.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#C2185B;align=left;spacing=12;fontSize=14;" parent="f1" vertex="1">
                    <mxGeometry x="80" y="510" width="460" height="230" as="geometry"/>
                </mxCell>
                <mxCell id="shipment" value="SHIPMENT / TRACKING&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;1. User processes order in Linnworks&lt;/div&gt;&lt;div&gt;2. Add carrier, service and tracking number&lt;/div&gt;&lt;div&gt;3. Linnworks calls despatch callback&lt;/div&gt;&lt;div&gt;4. Adapter sends shipment to Vendor&lt;/div&gt;&lt;div&gt;5. Checksum prevents duplicate shipment submission&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Owner action: confirm Vendor status and tracking.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F7FA;strokeColor=#00838F;align=left;spacing=12;fontSize=14;" parent="f1" vertex="1">
                    <mxGeometry x="600" y="510" width="460" height="230" as="geometry"/>
                </mxCell>
                <mxCell id="post" value="CANCELLATION / REFUND&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;1. State changes in Linnworks&lt;/div&gt;&lt;div&gt;2. Callback or scheduled cancellation push runs&lt;/div&gt;&lt;div&gt;3. Adapter updates Vendor&lt;/div&gt;&lt;div&gt;4. Local idempotency state prevents duplicate mutation&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Owner action: verify partial-operation rules before production use.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#D32F2F;align=left;spacing=12;fontSize=14;" parent="f1" vertex="1">
                    <mxGeometry x="1120" y="510" width="460" height="230" as="geometry"/>
                </mxCell>
                <mxCell id="ops" value="OPERATIONS FOR EVERY FLOW&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Use sync_logs + X-Correlation-ID to trace failures  •  Alert on missed scheduler runs and repeated tenant failures  •  429/5xx/connection errors retry with bounded backoff  •  Validation/auth failures require correction  •  Never advance an order cursor after an incomplete pull&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECEFF1;strokeColor=#455A64;strokeWidth=2;spacing=14;fontSize=14;fontStyle=1;" parent="f1" vertex="1">
                    <mxGeometry x="230" y="810" width="1190" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="fa1" value="scheduled pull" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#CC0000;strokeWidth=3;fontSize=12;" parent="f1" source="vendor" vendor="adapter" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="fa2" value="polling + callbacks" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=block;endArrow=block;strokeColor=#1976D2;strokeWidth=3;fontSize=12;" parent="f1" source="adapter" vendor="linn" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="checklist" name="3 - User Acceptance Checklist">
        <mxGraphModel dx="2016" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
            <root>
                <mxCell id="u0"/>
                <mxCell id="u1" parent="u0"/>
                <mxCell id="utitle" value="User Acceptance — Definition of Done" style="text;html=1;align=center;fontSize=26;fontStyle=1;fontColor=#1F2937;" parent="u1" vertex="1">
                    <mxGeometry x="350" y="20" width="950" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="unote" value="Record the order ID, SKU, listing ID, feed ID and correlation ID used for each test. Capture evidence from both Linnworks and Vendor." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F9A825;fontSize=14;fontStyle=1;" parent="u1" vertex="1">
                    <mxGeometry x="260" y="80" width="1130" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="h1" value="Capability" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#37474F;fontColor=#FFFFFF;fontStyle=1;fontSize=14;" parent="u1" vertex="1">
                    <mxGeometry x="50" y="180" width="230" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="h2" value="User action" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#37474F;fontColor=#FFFFFF;fontStyle=1;fontSize=14;" parent="u1" vertex="1">
                    <mxGeometry x="280" y="180" width="420" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="h3" value="Expected result" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#37474F;fontColor=#FFFFFF;fontStyle=1;fontSize=14;" parent="u1" vertex="1">
                    <mxGeometry x="700" y="180" width="560" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="h4" value="Pass" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#37474F;fontColor=#FFFFFF;fontStyle=1;fontSize=14;" parent="u1" vertex="1">
                    <mxGeometry x="1260" y="180" width="120" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="h5" value="Evidence / notes" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#37474F;fontColor=#FFFFFF;fontStyle=1;fontSize=14;" parent="u1" vertex="1">
                    <mxGeometry x="1380" y="180" width="220" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="r1a" value="1. Product/catalog sync" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#90A4AE;fontStyle=1;align=left;spacing=10;" parent="u1" vertex="1">
                    <mxGeometry x="50" y="230" width="230" height="105" as="geometry"/>
                </mxCell>
                <mxCell id="r1b" value="Run initial catalog sync and refresh channel products in Linnworks." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#90A4AE;align=left;spacing=10;" parent="u1" vertex="1">
                    <mxGeometry x="280" y="230" width="420" height="105" as="geometry"/>
                </mxCell>
                <mxCell id="r1c" value="Products appear with correct SKU, title, price and quantity; vendor_products contains the corresponding records." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#90A4AE;align=left;spacing=10;" parent="u1" vertex="1">
                    <mxGeometry x="700" y="230" width="560" height="105" as="geometry"/>
                </mxCell>
